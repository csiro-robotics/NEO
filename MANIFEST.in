include CITATION.cff
include environment.yml
include README.md
recursive-include docs *.md
recursive-include experiments/paper *.yaml
recursive-include tests *.py
graft submodules
global-exclude __pycache__ *.py[cod] *.egg-info
prune notebooks
exclude process_all_bags.py
exclude scripts/clean_outputs.sh
exclude scripts/eval_arucos.sh
exclude neo/eval/eval_chamfer_distance.py
exclude neo/eval/eval_dense_reprojection.py
exclude scripts/export_pointclouds.py
prune scripts/export_pointclouds_runtime_patch
exclude scripts/generate_depth_rmse_table.py
exclude scripts/generate_reproj_table.py
exclude scripts/generate_table_row.py
